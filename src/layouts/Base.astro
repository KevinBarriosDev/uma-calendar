---
import '../styles/global.css';
import { meta } from '../data';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <header class="site-header">
      <a href="/">Uma Calendar</a>
      <small>Career race calendar · Global server</small>
      <nav class="site-nav"><a href="/">Calendar</a> · <a href="/characters/">Umas</a> · <a href="/races/">Races</a></nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <p>Race data from <a href="https://umamusu.wiki">umamusu.wiki</a> (<a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>). Uma objectives: entered by the author; ones not yet checked in-game are marked unverified (updated {meta.builtAt}).</p>
      <p>Fan-made project. Not affiliated with Cygames. Umamusume: Pretty Derby is a trademark of Cygames, Inc.</p>
    </footer>
  </body>
</html>
